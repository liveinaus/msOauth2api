# ── Admin login (web UI) ──────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# JWT signing secret -- REQUIRED. Generate a unique value, e.g. `openssl rand -hex 32`.
# The app refuses to start if this is unset or left at a known placeholder.
JWT_SECRET=

# Optional but strongly recommended: encrypts stored account secrets at rest -- the
# Microsoft refresh tokens and mail passwords. Without it they sit in the SQLite file
# as plain text, so a copy of the data volume (a backup, a snapshot, a mounted disk)
# is every mailbox on the panel.
#
# Generate a unique value, e.g. `openssl rand -hex 32`. Deliberately separate from
# JWT_SECRET: rotating the JWT secret is routine and must not destroy stored tokens.
#
# READ BEFORE SETTING: keep this key safe and back it up. Lose it and the encrypted
# values cannot be recovered -- every account has to be imported again. Turning it on
# encrypts what is already stored on the next start; turning it off again does NOT
# decrypt, so remove it only if you are willing to re-import.
# MSAPI_DATA_KEY=

# ── Machine API access ────────────────────────────────────────────────────────
# The mail endpoints are meant to be called by scripts, so they authenticate with an
# API key rather than a login. Create keys in Settings; send one as either
# `X-API-Key: <key>` or the legacy `?password=<key>` query parameter.
#
# PASSWORD is the upstream project's shared secret and is still accepted verbatim, so
# automation written against the Vercel version keeps working unchanged. Prefer real
# API keys: a query parameter lands in access logs, proxy logs and browser history.
# PASSWORD=

# Guards /api/send-mail only, exactly as upstream. Unset, sending falls back to
# requiring a normal API key.
# SEND_PASSWORD=

# ── AI email summarisation (optional) ─────────────────────────────────────────
# Any OpenAI-compatible endpoint. AI_API_URL takes the origin without /v1.
# AI_API_KEY=
# AI_API_URL=https://api.openai.com
# AI_MODEL=gpt-4o-mini

# ── Server ────────────────────────────────────────────────────────────────────
# Optional: override the listen port (defaults to 3000)
# PORT=3000

# Optional: override the SQLite database path (defaults to /app/data/msoauth2api.db)
# DB_PATH=/app/data/msoauth2api.db

# Optional: timezone (defaults to UTC), e.g. TZ=Australia/Sydney
# TZ=Australia/Sydney

# Optional: number of reverse proxy hops in front of this app (defaults to 0).
# Set to 1 if behind nginx/Caddy/Traefik, 2 if behind Cloudflare + nginx.
# Required for rate limiting to work correctly when behind a proxy.
# TRUST_PROXY=1

# Optional: extra CORS origins, comma separated. The SPA is served same-origin in
# production so this is only needed for cross-origin browser callers.
# CORS_ORIGIN=https://example.com
